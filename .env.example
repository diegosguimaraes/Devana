# ==============================================================================
# Devana — Environment Variables Example
# Copy to .env and configure values for your environment (never commit .env).
# ==============================================================================

# Server port (default: 3000)
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Structured log level (pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Persistent backend vault directory (inside Docker: /app/data)
DATA_DIR=./data

# Public application URL
APP_URL="http://localhost:3000"

# Explicit CORS & WebSocket origin whitelist (comma-separated, no wildcard *)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Enforce X-Frame-Options: DENY & frame-ancestors 'none' (true in standalone production)
STRICT_FRAME_DENY=false

# Strong random secret (min. 16 chars) for HMAC verification of encrypted cloud backups
# Generate one with: openssl rand -hex 32
BACKUP_HMAC_KEY=""

# Optional Redis connection string for distributed rate limiting across multiple replicas
REDIS_URL=""

# Firebase server validation metadata (required if firebase-applet-config.json is absent)
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID="(default)"

# Firebase client SDK metadata (optional if firebase-applet-config.json exists locally)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""


